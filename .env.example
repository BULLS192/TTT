# Public launch URL. Use the final custom production domain before enabling indexing.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-side lead persistence. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional notification / automation endpoint. When configured, both general inquiries
# and project requests are also forwarded here after validation.
INQUIRY_WEBHOOK_URL=

# Apply supabase/project_requests.sql and supabase/inquiries.sql before enabling production submissions.
# Shopify and authentication variables will be added in their integration waves.
